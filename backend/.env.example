# Cổng chạy Backend API
PORT=5000

# Chuỗi kết nối PostgreSQL (Thay đổi mật khẩu và user tương ứng với máy local của bạn)
# Cú pháp: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql://postgres:123456@localhost:5432/badminton_saas_db

# Khóa bí mật JWT để ký và xác thực phiên đăng nhập
JWT_SECRET=super_secret_jwt_key_graduation_project_2026

# Cấu hình gửi OTP xác thực qua Gmail (Tùy chọn khi đăng ký/quên mật khẩu)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
